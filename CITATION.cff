cff-version: 1.2.0
message: >-
  If you use this code, please cite the manuscript listed under
  preferred-citation.
title: "Q100 HG002 v5.0q variant benchmark analysis code"
abstract: >-
  Snakemake workflow, analysis notebooks, and figure scripts used to
  characterize the GIAB HG002 v5.0q assembly-based small and structural variant
  benchmark sets.
type: software
authors:
  - family-names: "Olson"
    given-names: "Nathan D."
    affiliation: "National Institute of Standards and Technology"
    email: "nolson@nist.gov"
repository-code: "https://github.com/nate-d-olson/q100-variant-benchmark-paper"
license-url: "https://www.nist.gov/open/license"
version: "v5-submission"
date-released: "2026-09-22"
keywords:
  - Genome in a Bottle
  - HG002
  - variant benchmarking
  - structural variants
preferred-citation:
  type: article
  title: "The Genome In A Bottle HG002 assembly-based variant benchmark set enables comprehensive benchmarking of small and structural variants"
  status: preprint
  year: 2026
